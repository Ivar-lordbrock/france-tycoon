# Copier ce fichier en .env (jamais commité) puis remplir.

# --- Serveur ---
PORT=3000
APP_ORIGIN=http://localhost:5173
TZ=Europe/Paris
LOG_LEVEL=info

# --- Base SQLite ---
DATABASE_PATH=./data/france-tycoon.sqlite

# --- Google OAuth2 (console.cloud.google.com > Identifiants > ID client OAuth "Application Web") ---
GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=

# --- Carte ---
VITE_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_TILE_ATTRIBUTION=&copy; les contributeurs d'OpenStreetMap

# --- Règles du jeu (valeurs par défaut de docs/05-equilibrage.md) ---
INACTIVITY_DAYS=14
TAKEOVER_WINDOW_HOURS=24

# --- Fonctionnalités ---
FEATURE_SHOP=false

# --- V2 : paiements ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
