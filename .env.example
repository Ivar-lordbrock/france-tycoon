# Copier ce fichier en .env (jamais commité) puis remplir.

# --- Serveur ---
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
APP_ORIGIN=http://localhost:5173
TZ=Europe/Paris
LOG_LEVEL=info

# --- Base SQLite ---
DATABASE_PATH=./data/france-tycoon.sqlite

# --- Connexion ---
# ID client OAuth Google « Application Web » : guide pas à pas dans docs/08-connexion-google.md.
# Ce n'est pas un secret (le navigateur le reçoit par GET /api/v1/auth/config). Vide = pas de bouton Google.
GOOGLE_CLIENT_ID=
# Connexion de développement sans Google (« compte de test »), pour essayer le jeu en local.
# Jamais en production : le serveur refuse de démarrer avec NODE_ENV=production et AUTH_DEV=true.
AUTH_DEV=true
# Dashboard /admin : e-mails Google admin d'office, séparés par des virgules (vide = aucun admin).
ADMIN_EMAILS=

# --- Carte ---
VITE_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_TILE_ATTRIBUTION='&copy; <a href="https://www.openstreetmap.org/copyright">les contributeurs d’OpenStreetMap</a>'

# --- Avis des testeurs ---
# Lien « Donner mon avis » : lien d'un formulaire (https://…) ou adresse e-mail. Vide = lien caché.
# Il est copié dans le site (public) au moment de la construction.
VITE_AVIS_URL=

# --- Règles du jeu (valeurs par défaut de docs/05-equilibrage.md) ---
INACTIVITY_DAYS=14
TAKEOVER_WINDOW_HOURS=24

# --- Fonctionnalités ---
FEATURE_SHOP=false

# --- V2 : paiements ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
